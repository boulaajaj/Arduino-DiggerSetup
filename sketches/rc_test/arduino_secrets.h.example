// Wi-Fi AP credentials — TEMPLATE (#125, standard arduino_secrets.h pattern).
//
// Local build: copy this file to arduino_secrets.h (same folder, gitignored)
// and set the real password. CI copies this template automatically.
// The SSID is public by design (broadcast over the air, documented in
// CLAUDE.md/README); the PASSWORD must stay a placeholder here — never
// commit a real one.
#pragma once

#define SECRET_WIFI_SSID "Digger-Telemetry"
#define SECRET_WIFI_PASS "change-me-please"   // WPA2 requires >= 8 characters
